diff --git a/src/ue/rrc/capability.cpp b/src/ue/rrc/capability.cpp
new file mode 100644
index 0000000..bdad3d8
--- /dev/null
+++ b/src/ue/rrc/capability.cpp
@@ -0,0 +1,95 @@
+//
+// UE radio capability reporting (the project's testbed architecture notes §6.2, COMP997 addition).
+//
+// UERANSIM never implemented RRC UECapabilityEnquiry/Information (see
+// gnb/rrc/capability.cpp for the fuller explanation). This builds a minimal but
+// spec-valid UE-NR-Capability and reports it when the gNB asks. The capability
+// content itself is intentionally the same fixed/minimal container for every UE
+// profile - per the architecture doc, per-profile fingerprint differentiation
+// (SW-Std/SW-Ext/SW-Min) is the NGAP proxy's Stage 1 rewrite job, not the UE's.
+//
+
+#include "task.hpp"
+
+#include <lib/rrc/encode.hpp>
+
+#include <asn/rrc/ASN_RRC_BandNR.h>
+#include <asn/rrc/ASN_RRC_PDCP-Parameters.h>
+#include <asn/rrc/ASN_RRC_Phy-Parameters.h>
+#include <asn/rrc/ASN_RRC_RAT-Type.h>
+#include <asn/rrc/ASN_RRC_RF-Parameters.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-Container.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-ContainerList.h>
+#include <asn/rrc/ASN_RRC_UE-NR-Capability.h>
+#include <asn/rrc/ASN_RRC_UECapabilityEnquiry.h>
+#include <asn/rrc/ASN_RRC_UECapabilityInformation-IEs.h>
+#include <asn/rrc/ASN_RRC_UECapabilityInformation.h>
+#include <asn/rrc/ASN_RRC_UL-DCCH-Message.h>
+
+namespace nr::ue
+{
+
+// Minimal spec-valid UE-NR-Capability: only the four mandatory top-level fields
+// (accessStratumRelease, pdcp/phy/rf-Parameters) are populated; everything else
+// is legally OPTIONAL and left absent. A single band (n78, the testbed's own
+// band) is reported - the Stage 1 proxy rewrite overwrites this per profile.
+static ASN_RRC_UE_NR_Capability *buildMinimalUeNrCapability()
+{
+    auto *cap = asn::New<ASN_RRC_UE_NR_Capability>();
+    cap->accessStratumRelease = ASN_RRC_AccessStratumRelease_rel15;
+
+    // pdcp-Parameters: all ROHC profile bits false, smallest valid context-session enum
+    cap->pdcp_Parameters.maxNumberROHC_ContextSessions =
+        ASN_RRC_PDCP_Parameters__maxNumberROHC_ContextSessions_cs2;
+
+    // phy-Parameters: every substructure is OPTIONAL, leave fully absent
+    cap->phy_Parameters = {};
+
+    // rf-Parameters: one supported band (n78), no CA band combination list
+    auto *band = asn::New<ASN_RRC_BandNR>();
+    band->bandNR = 78;
+    asn::SequenceAdd(cap->rf_Parameters.supportedBandListNR, band);
+
+    return cap;
+}
+
+void UeRrcTask::receiveUeCapabilityEnquiry(const ASN_RRC_UECapabilityEnquiry &msg)
+{
+    m_logger->debug("UE Capability Enquiry received");
+
+    auto *nrCap = buildMinimalUeNrCapability();
+    OctetString nrCapBytes = rrc::encode::EncodeS(asn_DEF_ASN_RRC_UE_NR_Capability, nrCap);
+    asn::Free(asn_DEF_ASN_RRC_UE_NR_Capability, nrCap);
+
+    if (nrCapBytes.length() == 0)
+    {
+        m_logger->err("Failed to encode UE-NR-Capability");
+        return;
+    }
+
+    auto *container = asn::New<ASN_RRC_UE_CapabilityRAT_Container>();
+    container->rat_Type = ASN_RRC_RAT_Type_nr;
+    asn::SetOctetString(container->ue_CapabilityRAT_Container, nrCapBytes);
+
+    auto *pdu = asn::New<ASN_RRC_UL_DCCH_Message>();
+    pdu->message.present = ASN_RRC_UL_DCCH_MessageType_PR_c1;
+    pdu->message.choice.c1 =
+        asn::New<ASN_RRC_UL_DCCH_MessageType_t::ASN_RRC_UL_DCCH_MessageType_u::ASN_RRC_UL_DCCH_MessageType__c1>();
+    pdu->message.choice.c1->present = ASN_RRC_UL_DCCH_MessageType__c1_PR_ueCapabilityInformation;
+    pdu->message.choice.c1->choice.ueCapabilityInformation = asn::New<ASN_RRC_UECapabilityInformation>();
+
+    auto *info = pdu->message.choice.c1->choice.ueCapabilityInformation;
+    info->rrc_TransactionIdentifier = msg.rrc_TransactionIdentifier;
+    info->criticalExtensions.present = ASN_RRC_UECapabilityInformation__criticalExtensions_PR_ueCapabilityInformation;
+    info->criticalExtensions.choice.ueCapabilityInformation = asn::New<ASN_RRC_UECapabilityInformation_IEs>();
+    info->criticalExtensions.choice.ueCapabilityInformation->ue_CapabilityRAT_ContainerList =
+        asn::New<ASN_RRC_UE_CapabilityRAT_ContainerList>();
+    asn::SequenceAdd(*info->criticalExtensions.choice.ueCapabilityInformation->ue_CapabilityRAT_ContainerList,
+                      container);
+
+    m_logger->debug("Sending UE Capability Information");
+    sendRrcMessage(pdu);
+    asn::Free(asn_DEF_ASN_RRC_UL_DCCH_Message, pdu);
+}
+
+} // namespace nr::ue
