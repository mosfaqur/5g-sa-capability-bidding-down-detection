diff --git a/src/gnb/rrc/capability.cpp b/src/gnb/rrc/capability.cpp
new file mode 100644
index 0000000..c19813d
--- /dev/null
+++ b/src/gnb/rrc/capability.cpp
@@ -0,0 +1,112 @@
+//
+// UE radio capability retrieval (the project's testbed architecture notes §6.2, COMP997 addition).
+//
+// UERANSIM v3.2.6's gNB never implemented RRC UECapabilityEnquiry/Information at
+// all - it only referenced UERadioCapabilityInfoIndication in a criticality lookup
+// table for handling unknown incoming NGAP messages, never to send one. This means
+// the Python NGAP proxy built for the bidding-down attack study (which intercepts
+// and rewrites UERadioCapabilityInfoIndication) had nothing to intercept for the
+// three UERANSIM software profiles. This file adds the missing procedure: request
+// UE capability right after Initial Context Setup (context.cpp), relay the UE's
+// answer up to the AMF over NGAP (ngap/nas.cpp::sendUeRadioCapabilityInfoIndication).
+//
+
+#include "task.hpp"
+
+#include <gnb/ngap/task.hpp>
+#include <lib/rrc/encode.hpp>
+
+#include <asn/rrc/ASN_RRC_DL-DCCH-Message.h>
+#include <asn/rrc/ASN_RRC_RAT-Type.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-ContainerList.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-Request.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-RequestList.h>
+#include <asn/rrc/ASN_RRC_UE-CapabilityRAT-RequestList.h>
+#include <asn/rrc/ASN_RRC_UECapabilityEnquiry-IEs.h>
+#include <asn/rrc/ASN_RRC_UECapabilityEnquiry.h>
+#include <asn/rrc/ASN_RRC_UECapabilityInformation-IEs.h>
+#include <asn/rrc/ASN_RRC_UECapabilityInformation.h>
+#include <asn/rrc/ASN_RRC_UERadioAccessCapabilityInformation-IEs.h>
+#include <asn/rrc/ASN_RRC_UERadioAccessCapabilityInformation.h>
+
+namespace nr::gnb
+{
+
+void GnbRrcTask::sendUeCapabilityEnquiry(int ueId)
+{
+    auto *pdu = asn::New<ASN_RRC_DL_DCCH_Message>();
+    pdu->message.present = ASN_RRC_DL_DCCH_MessageType_PR_c1;
+    pdu->message.choice.c1 =
+        asn::New<ASN_RRC_DL_DCCH_MessageType_t::ASN_RRC_DL_DCCH_MessageType_u::ASN_RRC_DL_DCCH_MessageType__c1>();
+    pdu->message.choice.c1->present = ASN_RRC_DL_DCCH_MessageType__c1_PR_ueCapabilityEnquiry;
+    pdu->message.choice.c1->choice.ueCapabilityEnquiry = asn::New<ASN_RRC_UECapabilityEnquiry>();
+
+    auto *enquiry = pdu->message.choice.c1->choice.ueCapabilityEnquiry;
+    enquiry->rrc_TransactionIdentifier = getNextTid();
+    enquiry->criticalExtensions.present = ASN_RRC_UECapabilityEnquiry__criticalExtensions_PR_ueCapabilityEnquiry;
+    enquiry->criticalExtensions.choice.ueCapabilityEnquiry = asn::New<ASN_RRC_UECapabilityEnquiry_IEs>();
+
+    auto *request = asn::New<ASN_RRC_UE_CapabilityRAT_Request>();
+    request->rat_Type = ASN_RRC_RAT_Type_nr;
+    asn::SequenceAdd(enquiry->criticalExtensions.choice.ueCapabilityEnquiry->ue_CapabilityRAT_RequestList, request);
+
+    m_logger->debug("Sending UE Capability Enquiry to UE[%d]", ueId);
+    sendRrcMessage(ueId, pdu);
+    asn::Free(asn_DEF_ASN_RRC_DL_DCCH_Message, pdu);
+}
+
+void GnbRrcTask::receiveUeCapabilityInformation(int ueId, const ASN_RRC_UECapabilityInformation &msg)
+{
+    if (msg.criticalExtensions.present != ASN_RRC_UECapabilityInformation__criticalExtensions_PR_ueCapabilityInformation)
+        return;
+
+    auto *ies = msg.criticalExtensions.choice.ueCapabilityInformation;
+    if (ies == nullptr || ies->ue_CapabilityRAT_ContainerList == nullptr)
+        return;
+
+    // Re-encode just the capability container list (UPER, its own type descriptor) -
+    // this is the inner content that the outer UERadioAccessCapabilityInformation
+    // wraps, per the live capture ground truth in the project's testbed architecture notes §6.2.
+    OctetString containerListBytes =
+        rrc::encode::EncodeS(asn_DEF_ASN_RRC_UE_CapabilityRAT_ContainerList, ies->ue_CapabilityRAT_ContainerList);
+    if (containerListBytes.length() == 0)
+    {
+        m_logger->err("Failed to encode UE-CapabilityRAT-ContainerList for UE[%d]", ueId);
+        return;
+    }
+
+    // Wrap in UERadioAccessCapabilityInformation - the actual NGAP UERadioCapability
+    // IE content (confirmed against a real handset capture, not assumed from the
+    // spec text: the NGAP IE is not a bare UE-CapabilityRAT-ContainerList).
+    auto *outer = asn::New<ASN_RRC_UERadioAccessCapabilityInformation>();
+    outer->criticalExtensions.present = ASN_RRC_UERadioAccessCapabilityInformation__criticalExtensions_PR_c1;
+    outer->criticalExtensions.choice.c1 = asn::New<
+        ASN_RRC_UERadioAccessCapabilityInformation_t::ASN_RRC_UERadioAccessCapabilityInformation__criticalExtensions::
+            ASN_RRC_UERadioAccessCapabilityInformation__ASN_RRC_criticalExtensions_u::
+                ASN_RRC_UERadioAccessCapabilityInformation__criticalExtensions__c1>();
+    outer->criticalExtensions.choice.c1->present =
+        ASN_RRC_UERadioAccessCapabilityInformation__criticalExtensions__c1_PR_ueRadioAccessCapabilityInformation;
+    outer->criticalExtensions.choice.c1->choice.ueRadioAccessCapabilityInformation =
+        asn::New<ASN_RRC_UERadioAccessCapabilityInformation_IEs>();
+    asn::SetOctetString(
+        outer->criticalExtensions.choice.c1->choice.ueRadioAccessCapabilityInformation->ue_RadioAccessCapabilityInfo,
+        containerListBytes);
+
+    OctetString outerBytes = rrc::encode::EncodeS(asn_DEF_ASN_RRC_UERadioAccessCapabilityInformation, outer);
+    asn::Free(asn_DEF_ASN_RRC_UERadioAccessCapabilityInformation, outer);
+
+    if (outerBytes.length() == 0)
+    {
+        m_logger->err("Failed to encode UERadioAccessCapabilityInformation for UE[%d]", ueId);
+        return;
+    }
+
+    m_logger->debug("UE Capability Information received from UE[%d], forwarding to NGAP", ueId);
+
+    auto w = std::make_unique<NmGnbRrcToNgap>(NmGnbRrcToNgap::UE_CAPABILITY_INFO);
+    w->ueId = ueId;
+    w->pdu = std::move(outerBytes);
+    m_base->ngapTask->push(std::move(w));
+}
+
+} // namespace nr::gnb
