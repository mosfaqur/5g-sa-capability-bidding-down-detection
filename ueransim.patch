@@ -4,6 +4,13 @@ project(ueransim)
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_C_STANDARD 11)
 
+# This codebase (2022-era) relies on transitive standard-library includes
+# (<cstdint>, <cstring>, etc.) that older GCC/libstdc++ pulled in implicitly
+# via other headers. Newer GCC (15.x here) is stricter and rejects these as
+# missing declarations. Force-including the common offenders everywhere is
+# far less invasive than patching every source file individually.
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -include cstdint -include cstring -include cstdio -include string")
+
 include_directories(src)
 
